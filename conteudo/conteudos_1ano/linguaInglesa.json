  "conteudos": [
    {
      "titulo": "Verb to be",
      "aula": "O verbo to be significa ser ou estar. No presente, suas formas principais são am, is e are, escolhidas conforme o sujeito."
    },
    {
      "titulo": "Simple Present",
      "aula": "O Simple Present é usado para hábitos, rotinas e fatos gerais. Na terceira pessoa do singular, geralmente se acrescenta -s ou -es ao verbo."
    },
    {
      "titulo": "Personal pronouns",
      "aula": "Pronomes pessoais como I, you, he, she, it, we e they indicam quem pratica ou recebe a ação na frase."
    }
  ],
  "questoes": [
    {
      "pergunta": "Qual é a forma correta: 'She ___ happy'?",
      "alternativas": [
        {
          "id": "A",
          "texto": "am"
        },
        {
          "id": "B",
          "texto": "is"
        },
        {
          "id": "C",
          "texto": "are"
        },
        {
          "id": "D",
          "texto": "be"
        }
      ],
      "resposta_correta": "B",
      "explicacao": "Com she, usamos is no presente do verbo to be."
    },
    {
      "pergunta": "Qual frase expressa um hábito?",
      "alternativas": [
        {
          "id": "A",
          "texto": "I am sleeping now."
        },
        {
          "id": "B",
          "texto": "I play soccer every Saturday."
        },
        {
          "id": "C",
          "texto": "I played yesterday."
        },
        {
          "id": "D",
